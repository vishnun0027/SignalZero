[Unit]
Description=SignalZero FastAPI daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/vishnu/worklab/SignalZero
ExecStart=/home/vishnu/worklab/SignalZero/.venv/bin/python -m signalzero.services.api.main
Restart=always
RestartSec=5
StandardOutput=append:/home/vishnu/worklab/SignalZero/signalzero.log
StandardError=append:/home/vishnu/worklab/SignalZero/signalzero.log
EnvironmentFile=/home/vishnu/worklab/SignalZero/.env

[Install]
WantedBy=default.target
