# SignalZero Environment Configuration Template
# Copy this to .env and fill in your credentials

# Application Environments: development, production
ENV=development
HOST=127.0.0.1
PORT=8007

# Database Configuration - Supabase PostgreSQL URL
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres:your-supabase-password@db.your-supabase-project.supabase.co:5432/postgres

# Graph Database Configuration - Neo4j AuraDB
NEO4J_URI=neo4j+s://your-aura-db-uri.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Caching & Time-Series - Upstash Redis or Local
REDIS_URL=rediss://default:your-upstash-redis-password@your-redis-endpoint.upstash.io:6379

# LLM Inference API Keys
GROQ_API_KEY=gsk_your_groq_api_key
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# Security JWT Secret (auto-generates if left blank)
JWT_SECRET_KEY=
